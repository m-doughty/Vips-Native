use Test;
use lib 'lib';

use Vips::Native;

# Strict decode uses libvips fail_on=warning for in-memory sources. The bad PNG
# below is deliberately well-framed (valid signature/chunk CRCs) but has an IDAT
# payload that cannot produce the 1x1 RGBA scanline. The lazy decode path must
# fail when pixels are materialised, not accept a partially decoded image.
#
# libvips reports that corruption as warnings on stderr ("VIPS-WARNING: Not
# enough image data", "error in tile 0 x 0") as well as failing the decode, and
# a test run's stderr is to stay empty. VIPS_WARNING in the environment
# silences them, but libvips reads it once, inside vips_init -- which
# Vips::Native runs as it loads, before any line here -- and from the C
# environment, which %*ENV does not write to. So the corrupt PNG is decoded in a
# child process started with VIPS_WARNING=1, and its stderr is captured rather
# than inherited.

constant ALPHA = 't/fixtures/alpha-split.png';

plan 14;

sub be32(Int:D $n --> List) { (($n +> 24) +& 0xff, ($n +> 16) +& 0xff, ($n +> 8) +& 0xff, $n +& 0xff) }
sub le16(Int:D $n --> List) { ($n +& 0xff, ($n +> 8) +& 0xff) }

sub crc32-pure(Blob:D $data --> Int) {
	state @table = (0 .. 255).map(-> $i {
		my Int $c = $i;
		for ^8 {
			$c = ($c +& 1) ?? (0xedb88320 +^ ($c +> 1)) !! ($c +> 1);
		}
		$c +& 0xffffffff;
	});
	my Int $crc = 0xffffffff;
	for $data.list -> $byte {
		$crc = @table[($crc +^ $byte.Int) +& 0xff] +^ ($crc +> 8);
	}
	($crc +^ 0xffffffff) +& 0xffffffff;
}

sub adler32(Blob:D $data --> Int) {
	my Int $s1 = 1;
	my Int $s2 = 0;
	for $data.list -> $byte {
		$s1 = ($s1 + $byte.Int) % 65521;
		$s2 = ($s2 + $s1) % 65521;
	}
	(($s2 +< 16) +| $s1) +& 0xffffffff;
}

sub chunk(Str:D $type, *@data --> List) {
	my Blob $payload = Buf[uint8].new(@data);
	my Blob $crc-input = Buf[uint8].new(|$type.encode('ascii').list, |$payload.list);
	(|be32($payload.bytes), |$type.encode('ascii').list, |$payload.list, |be32(crc32-pure($crc-input)));
}

sub zlib-store(@bytes --> List) {
	my Blob $payload = Buf[uint8].new(@bytes);
	my Int $len = $payload.bytes;
	die 'fixture payload too large for one stored deflate block' if $len > 65535;
	my Int $nlen = (0xffff +^ $len) +& 0xffff;
	(0x78, 0x01, 0x01, |le16($len), |le16($nlen), |$payload.list, |be32(adler32($payload)));
}

sub png-from-idat(@idat --> Buf[uint8]) {
	Buf[uint8].new(
		0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a,
		|chunk('IHDR', |be32(1), |be32(1), 8, 6, 0, 0, 0),
		|chunk('IDAT', |@idat),
		|chunk('IEND'),
	);
}

sub valid-rgba-png(Int:D $r, Int:D $g, Int:D $b, Int:D $a --> Buf[uint8]) {
	png-from-idat(zlib-store([0, $r, $g, $b, $a]));
}

sub bad-framed-png(--> Buf[uint8]) {
	png-from-idat([0]);
}

sub px($img, Int $x, Int $y) {
	my $i = ($y * $img.width + $x) * 4;
	$img.rgba[$i .. $i + 3].List;
}

my $red = valid-rgba-png(255, 0, 0, 255);
my $default-red = decode-to-rgba($red);
my $strict-red = decode-to-rgba($red, :strict);
isa-ok $strict-red, Vips::Native::RawRgba, 'decode-to-rgba(Blob, :strict) returns RawRgba for a valid PNG';
is $strict-red.width, 1, 'strict valid PNG width is preserved';
is $strict-red.height, 1, 'strict valid PNG height is preserved';
is-deeply px($strict-red, 0, 0), (255, 0, 0, 255).List, 'strict valid PNG has exact RGBA pixel';
ok $strict-red.rgba eqv $default-red.rgba, 'strict and default decodes match for generated valid PNG';

my $alpha-default = decode-to-rgba(ALPHA.IO.slurp(:bin));
my $alpha-strict = decode-to-rgba(ALPHA.IO.slurp(:bin), :strict);
ok $alpha-strict.rgba eqv $alpha-default.rgba, 'strict and default decodes match for known-valid alpha fixture';
is-deeply px($alpha-strict, 0, 0), (255, 0, 0, 0).List, 'strict fixture keeps transparent RGBA pixel';
is-deeply px($alpha-strict, 7, 7), (0, 255, 0, 255).List, 'strict fixture keeps opaque RGBA pixel';

{
	# The child answers with its exit code, not its output: GLib writes
	# its info messages to stdout, so under CI's VIPS_INFO=1 the child's
	# stdout is mostly VIPS-INFO lines. Distinct codes also keep a child
	# that dies (1) or is killed (signal, exit code 0) from passing.
	my constant ACCEPTED = 10;
	my constant REJECTED = 11;
	my %env = %*ENV;
	%env<VIPS_WARNING> = '1';
	my $child = run $*EXECUTABLE.absolute,
		'-I' ~ $*PROGRAM.parent.parent.add('lib').absolute,
		'-e', 'use Vips::Native; '
			~ "my \$png = Buf[uint8].new({bad-framed-png().list.join(',')}); "
			~ "exit decode-to-rgba(\$png, :strict).so ?? {ACCEPTED} !! {REJECTED}",
		:%env, :out, :err;
	my Str $out = $child.out.slurp(:close);
	my Str $err = $child.err.slurp(:close);
	ok $child.exitcode == REJECTED && $child.signal == 0,
		'strict decode rejects well-framed corrupt PNG during materialisation'
		or diag ($child.exitcode == ACCEPTED ?? 'the child accepted it'
			!! "exit code {$child.exitcode}, signal {$child.signal}")
			~ "; child stdout:\n$out\nchild stderr:\n$err";
}
nok decode-to-rgba(buf8.new, :strict).so, 'strict decode rejects empty buffer cleanly';
nok decode-to-rgba(Buf[uint8].new(1, 2, 3, 4, 5), :strict).so, 'strict decode rejects garbage bytes cleanly';
nok decode-to-rgba(Blob[uint32].new(0x474E5089, 1, 2, 3), :strict).so, 'strict decode rejects wide Blob elements';
ok decode-to-rgba($red).rgba eqv $default-red.rgba, 'default mode remains available for good Blob input';
ok smart-resize-buffer($red, 1, 1).bytes > 0, 'strict decode option does not change other default buffer APIs';
